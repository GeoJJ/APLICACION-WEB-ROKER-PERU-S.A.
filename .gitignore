# =====================================================
# .gitignore - APLICACION-WEB-ROKER-PERU-S.A.
# Estructura: backend/ + frontend/
# =====================================================

# ----- SECRETOS Y CONFIGURACIÓN LOCAL -----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
config.local.*
secrets.*
credentials.json
service-account*.json

# ----- NODE.JS / FRONTEND -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Builds y cachés del frontend
dist/
build/
out/
.next/
.nuxt/
.angular/
.vite/
.svelte-kit/
.parcel-cache/
.cache/
.turbo/
storybook-static/

# ----- TESTING Y COBERTURA -----
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/



# ----- JAVA / SPRING BOOT / MAVEN / GRADLE -----
target/
*.class
*.jar
*.war
*.ear
.gradle/
.mvn/wrapper/maven-wrapper.jar
hs_err_pid*

# ----- .NET 
bin/
obj/
*.user
*.suo
.vs/
[Dd]ebug/
[Rr]elease/
appsettings.Development.json
appsettings.Local.json

# ----- BASES DE DATOS Y ARCHIVOS SUBIDOS -----
*.sqlite
*.sqlite3
*.db
*.sql.bak
*.dump
*.bak
uploads/
backend/uploads/
backend/public/uploads/


# ----- LOGS Y TEMPORALES -----
*.log
logs/
tmp/
temp/
*.tmp
*.temp
pids/
*.pid
*.seed

# ----- VISUAL STUDIO CODE -----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.vscode-test/
*.code-workspace
.history/
*.vsix

# ----- OTROS IDEs -----
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache
.nb-gradle/
nbproject/private/
nbbuild/
nbdist/

# ----- SISTEMA OPERATIVO -----
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- ARCHIVOS COMPRIMIDOS Y PESADOS -----
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# ----- ARCHIVOS GENERADOS POR IDEs -----
HELP.md