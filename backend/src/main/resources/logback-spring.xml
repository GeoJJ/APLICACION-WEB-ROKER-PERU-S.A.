<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Consola: corta y con colores. Archivo: fecha completa, hilo y sin colores -->
    <property name="PATRON_CONSOLA"
              value="%gray(%d{HH:mm:ss.SSS}) %highlight(%-5level) %cyan(%-40.40logger{39}) : %msg%n%ex{12}"/>
    <property name="PATRON_ARCHIVO"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %-40.40logger{39} : %msg%n%ex{30}"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PATRON_CONSOLA}</pattern>
        </encoder>
    </appender>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/roker-peru.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/roker-peru-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PATRON_ARCHIVO}</pattern>
        </encoder>
    </appender>

    <!-- Tu código: detallado -->
    <logger name="RokerPeru.demo" level="DEBUG"/>

    <!-- SQL: se mantiene, pero se silencia el resto de Hibernate -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.SQL" level="DEBUG"/>
    <!-- Descomenta para ver los VALORES de los ? en cada consulta -->
    <!-- <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/> -->

    <!-- Ruido de arranque -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.apache" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>