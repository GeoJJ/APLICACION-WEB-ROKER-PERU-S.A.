<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="comprobante"
              language="java"
              pageWidth="226"
              pageHeight="842"
              columnWidth="210"
              leftMargin="8"
              rightMargin="8"
              topMargin="10"
              bottomMargin="10">

    <!-- DATOS DE LA EMPRESA -->
    <parameter name="razonSocial" class="java.lang.String"/>
    <parameter name="rucEmpresa" class="java.lang.String"/>
    <parameter name="direccionEmpresa" class="java.lang.String"/>
    <parameter name="logo" class="java.io.InputStream"/>

    <!-- DATOS DEL COMPROBANTE -->
    <parameter name="tipoComprobante" class="java.lang.String"/>
    <parameter name="tipoOperacion" class="java.lang.String"/>
    <parameter name="numeroComprobante" class="java.lang.String"/>
    <parameter name="fechaEmision" class="java.util.Date"/>
    <parameter name="formaPago" class="java.lang.String"/>
    <parameter name="referencia" class="java.lang.String"/>
    <parameter name="atendidoPor" class="java.lang.String"/>

    <!-- DATOS DEL CLIENTE -->
    <parameter name="clienteNombre" class="java.lang.String"/>
    <parameter name="clienteDocumentoTipo" class="java.lang.String"/>
    <parameter name="clienteDocumentoNumero" class="java.lang.String"/>
    <parameter name="clienteDireccion" class="java.lang.String"/>
    <!-- false = venta presencial: la boleta solo muestra el DNI (sin nombre ni dirección) -->
    <parameter name="clienteCompleto" class="java.lang.Boolean"/>

    <!-- TOTALES -->
    <parameter name="subtotal" class="java.math.BigDecimal"/>
    <parameter name="impuestoMonto" class="java.math.BigDecimal"/>
    <parameter name="total" class="java.math.BigDecimal"/>

    <!-- DETALLE -->
    <field name="descripcion" class="java.lang.String"/>
    <field name="cantidad" class="java.math.BigDecimal"/>
    <field name="precioUnitario" class="java.math.BigDecimal"/>
    <field name="importe" class="java.math.BigDecimal"/>

    <!-- ENCABEZADO -->
    <title height="308">
        <element kind="image" x="5" y="0" width="200" height="50"
                 scaleImage="RetainShape" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank">
            <expression><![CDATA[$P{logo}]]></expression>
        </element>
        <element kind="textField" x="5" y="52" width="200" height="22"
                 fontName="SansSerif" fontSize="15" bold="true" forecolor="#00428A" hTextAlign="Center">
            <expression><![CDATA[$P{razonSocial}]]></expression>
        </element>
        <element kind="textField" x="5" y="76" width="200" height="14" fontSize="9" hTextAlign="Center">
            <expression><![CDATA["RUC: " + $P{rucEmpresa}]]></expression>
        </element>
        <element kind="textField" x="5" y="90" width="200" height="25" fontSize="8" hTextAlign="Center">
            <expression><![CDATA[$P{direccionEmpresa}]]></expression>
        </element>
        <!-- RAYA 1 (más grande) -->
        <element kind="staticText" x="5" y="118" width="200" height="12" fontSize="9" bold="true" hTextAlign="Center">
            <text><![CDATA[--------------------------------------------------]]></text>
        </element>
        <element kind="textField" x="5" y="132" width="200" height="17"
                 fontSize="11" bold="true" forecolor="#00428A" hTextAlign="Center">
            <expression><![CDATA[$P{tipoComprobante}]]></expression>
        </element>
        <element kind="textField" x="5" y="151" width="200" height="15" fontSize="10" bold="true" hTextAlign="Center">
            <expression><![CDATA[$P{numeroComprobante}]]></expression>
        </element>
        <element kind="textField" x="5" y="169" width="200" height="13" fontSize="8" hTextAlign="Center">
            <expression><![CDATA["Emisión: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($P{fechaEmision})]]></expression>
        </element>
        <element kind="textField" x="5" y="183" width="200" height="13" fontSize="8" hTextAlign="Center">
            <expression><![CDATA["Operación: " + $P{tipoOperacion}]]></expression>
        </element>
        <element kind="textField" x="5" y="197" width="200" height="13" fontSize="8" hTextAlign="Center">
            <expression><![CDATA[$P{referencia}]]></expression>
        </element>
        <element kind="staticText" x="5" y="214" width="200" height="12" fontSize="8" bold="true">
            <text><![CDATA[DATOS DEL CLIENTE]]></text>
        </element>
        <element kind="textField" x="5" y="228" width="200" height="13" fontSize="8">
            <expression><![CDATA[Boolean.FALSE.equals($P{clienteCompleto}) ? "" : "Cliente: " + $P{clienteNombre}]]></expression>
        </element>
        <element kind="textField" x="5" y="242" width="200" height="13" fontSize="8">
            <expression><![CDATA[$P{clienteDocumentoTipo} + ": " + $P{clienteDocumentoNumero}]]></expression>
        </element>
        <element kind="textField" x="5" y="256" width="200" height="22" fontSize="8">
            <expression><![CDATA[Boolean.FALSE.equals($P{clienteCompleto}) ? "" : "Dirección: " + $P{clienteDireccion}]]></expression>
        </element>
        <element kind="textField" x="5" y="280" width="200" height="13" fontSize="8">
            <expression><![CDATA["Atendido por: " + $P{atendidoPor}]]></expression>
        </element>
        <!-- RAYA 2 (más grande) -->
        <element kind="staticText" x="5" y="295" width="200" height="12" fontSize="9" bold="true" hTextAlign="Center">
            <text><![CDATA[--------------------------------------------------]]></text>
        </element>
    </title>

    <!-- ══════════════════════════════════════════════════════════════
         TABLA REAL: 4 columnas. Cada título comparte la MISMA x/width
         y alineación que su valor en el <detail>. Así nada flota.
         Descripción | Cant. | P.Unit. | Importe
         x=5..105    | 105..127 | 127..165 | 165..205
         ══════════════════════════════════════════════════════════════ -->
    <columnHeader height="26">
        <element kind="staticText" x="5" y="0" width="200" height="13" fontSize="9" bold="true">
            <text><![CDATA[DETALLE DE LA OPERACIÓN]]></text>
        </element>
        <element kind="staticText" x="5" y="14" width="100" height="12" fontSize="7" bold="true">
            <text><![CDATA[Descripción]]></text>
        </element>
        <element kind="staticText" x="105" y="14" width="22" height="12" fontSize="7" bold="true" hTextAlign="Right">
            <text><![CDATA[Cant.]]></text>
        </element>
        <element kind="staticText" x="127" y="14" width="38" height="12" fontSize="7" bold="true" hTextAlign="Right">
            <text><![CDATA[P.Unit.]]></text>
        </element>
        <element kind="staticText" x="165" y="14" width="40" height="12" fontSize="7" bold="true" hTextAlign="Right">
            <text><![CDATA[Importe]]></text>
        </element>
    </columnHeader>

    <!-- DETALLE: una sola fila por producto, las 4 columnas en la misma y -->
    <detail>
        <band height="18">
            <element kind="textField" x="5" y="0" width="100" height="18" fontSize="7" vTextAlign="Middle" textAdjust="StretchHeight">
                <expression><![CDATA[$F{descripcion}]]></expression>
            </element>
            <element kind="textField" x="105" y="0" width="22" height="18" fontSize="7" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[new java.text.DecimalFormat("#,##0.##").format($F{cantidad})]]></expression>
            </element>
            <element kind="textField" x="127" y="0" width="38" height="18" fontSize="7" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[new java.text.DecimalFormat("#,##0.00").format($F{precioUnitario})]]></expression>
            </element>
            <element kind="textField" x="165" y="0" width="40" height="18" fontSize="7" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA["S/ " + new java.text.DecimalFormat("#,##0.00").format($F{importe})]]></expression>
            </element>
        </band>
    </detail>

    <!-- TOTALES -->
    <summary height="122">
        <!-- RAYA 3 (más grande) -->
        <element kind="staticText" x="5" y="0" width="200" height="12" fontSize="9" bold="true" hTextAlign="Center">
            <text><![CDATA[--------------------------------------------------]]></text>
        </element>
        <element kind="staticText" x="5" y="15" width="100" height="14" fontSize="9">
            <text><![CDATA[Subtotal:]]></text>
        </element>
        <element kind="textField" x="105" y="15" width="100" height="14" fontSize="9" hTextAlign="Right">
            <expression><![CDATA["S/ " + new java.text.DecimalFormat("#,##0.00").format($P{subtotal})]]></expression>
        </element>
        <element kind="staticText" x="5" y="32" width="100" height="14" fontSize="9">
            <text><![CDATA[IGV:]]></text>
        </element>
        <element kind="textField" x="105" y="32" width="100" height="14" fontSize="9" hTextAlign="Right">
            <expression><![CDATA["S/ " + new java.text.DecimalFormat("#,##0.00").format($P{impuestoMonto})]]></expression>
        </element>
        <element kind="staticText" x="5" y="51" width="100" height="18" fontSize="11" bold="true" forecolor="#00428A">
            <text><![CDATA[TOTAL:]]></text>
        </element>
        <element kind="textField" x="105" y="51" width="100" height="18" fontSize="11" bold="true" forecolor="#00428A" hTextAlign="Right">
            <expression><![CDATA["S/ " + new java.text.DecimalFormat("#,##0.00").format($P{total})]]></expression>
        </element>
        <element kind="staticText" x="5" y="74" width="200" height="12" fontSize="8">
            <text><![CDATA[Forma de pago:]]></text>
        </element>
        <element kind="textField" x="80" y="74" width="125" height="12" fontSize="8" hTextAlign="Right">
            <expression><![CDATA[$P{formaPago}]]></expression>
        </element>
        <element kind="staticText" x="5" y="91" width="200" height="12" fontSize="8" bold="true" forecolor="#00428A" hTextAlign="Center">
            <text><![CDATA[¡GRACIAS POR SU PREFERENCIA!]]></text>
        </element>
        <element kind="textField" x="5" y="106" width="200" height="12" fontSize="7" hTextAlign="Center">
            <expression><![CDATA[$P{razonSocial} + " - Calidad y confianza"]]></expression>
        </element>
    </summary>
</jasperReport>