meta {
  name: Crear rol ALMACENISTA (si no existe)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreRol": "ALMACENISTA"
  }
}

tests {
  test("Responde 201 o 409", function() {
    expect([201,409]).to.include(res.status);
  });
}
