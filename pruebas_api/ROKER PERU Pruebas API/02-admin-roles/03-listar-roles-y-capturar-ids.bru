meta {
  name: Listar roles y capturar ids
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/admin/roles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

script:post-response {
  if (res.status === 200) {
    const map = { ADMINISTRADOR: "idRolAdmin", VENDEDOR: "idRolVendedor", REPARTIDOR: "idRolRepartidor", CLIENTE: "idRolCliente", GERENTE_GENERAL: "idRolGerente", ALMACENISTA: "idRolAlmacenista" };
    res.body.forEach(r => { const k = map[(r.nombreRol || "").toUpperCase()]; if (k) bru.setVar(k, r.idRol); });
  }
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Devuelve una lista", function() {
    expect(res.body).to.be.an("array");
  });

  test("Existen los 6 roles del sistema", function() {
    const n = res.body.map(r => r.nombreRol.toUpperCase());
    ["ADMINISTRADOR","VENDEDOR","REPARTIDOR","CLIENTE","GERENTE_GENERAL","ALMACENISTA"].forEach(x => expect(n).to.include(x));
  });
}
