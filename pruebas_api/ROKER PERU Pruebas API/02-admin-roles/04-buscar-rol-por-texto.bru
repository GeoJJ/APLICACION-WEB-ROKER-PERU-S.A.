meta {
  name: Buscar rol por texto
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/admin/roles/buscar?texto=gerente
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Encuentra GERENTE_GENERAL", function() {
    expect(res.body.some(r => r.nombreRol.toUpperCase().includes("GERENTE"))).to.equal(true);
  });
}
