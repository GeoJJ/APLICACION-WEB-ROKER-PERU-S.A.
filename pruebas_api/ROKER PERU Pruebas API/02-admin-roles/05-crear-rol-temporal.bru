meta {
  name: Crear rol temporal
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admin/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreRol": "TEMP{{run}}"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idRolTemp", res.body.idRol);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Devuelve idRol", function() {
    expect(res.body.idRol).to.be.a("number");
  });
}
