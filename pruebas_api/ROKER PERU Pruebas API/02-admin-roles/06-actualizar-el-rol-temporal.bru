meta {
  name: Actualizar el rol temporal
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/admin/roles/{{idRolTemp}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreRol": "TEMPEDIT{{run}}"
  }
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Nombre actualizado", function() {
    expect(res.body.nombreRol).to.contain("TEMPEDIT");
  });
}
