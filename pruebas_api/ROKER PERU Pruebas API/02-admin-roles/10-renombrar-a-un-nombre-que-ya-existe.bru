meta {
  name: Renombrar a un nombre que ya existe
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/admin/roles/{{idRolTemp}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreRol": "CLIENTE"
  }
}

tests {
  test("Responde 409", function() {
    expect(res.status).to.equal(409);
  });

  test("Cuerpo de error con status 409", function() {
    expect(res.body.status).to.equal(409);
  });
}
