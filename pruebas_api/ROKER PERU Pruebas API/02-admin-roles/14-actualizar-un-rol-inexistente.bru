meta {
  name: Actualizar un rol inexistente
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/admin/roles/999999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreRol": "FANTASMA"
  }
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
