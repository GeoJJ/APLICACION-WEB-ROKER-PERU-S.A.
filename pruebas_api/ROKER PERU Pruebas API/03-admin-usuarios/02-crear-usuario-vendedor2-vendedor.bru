meta {
  name: Crear usuario vendedor2 (VENDEDOR)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreUsuario": "Lucia Fernanda Paredes Salas",
    "correoUsuario": "lucia.paredes.{{run}}@rokerperu.test",
    "tipoPersonaUsuario": "NATURAL",
    "numeroDocumentoUsuario": "{{dniVendedor2}}",
    "telefonoUsuario": "986543210",
    "direccionUsuario": "Calle San Francisco 210, Cercado, Arequipa",
    "idRol": {{idRolVendedor}},
    "passwordUsuario": "{{passwordUsuarios}}"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idVendedor2", res.body.idUsuario);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Rol correcto", function() {
    expect(res.body.nombreRol).to.equal("VENDEDOR");
  });

  test("Correo en minusculas", function() {
    expect(res.body.correoUsuario).to.equal(res.body.correoUsuario.toLowerCase());
  });

  test("No devuelve la contrasena", function() {
    expect(res.body).to.not.have.property("passwordUsuario");
  });
}
