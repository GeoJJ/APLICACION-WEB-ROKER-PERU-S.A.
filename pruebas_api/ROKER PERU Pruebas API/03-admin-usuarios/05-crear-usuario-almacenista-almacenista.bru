meta {
  name: Crear usuario almacenista (ALMACENISTA)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admin/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreUsuario": "Almacenista Prueba {{run}}",
    "correoUsuario": "almacenista.{{run}}@rokerperu.test",
    "tipoPersonaUsuario": "NATURAL",
    "numeroDocumentoUsuario": "{{dniAlmacenista}}",
    "telefonoUsuario": "987654321",
    "direccionUsuario": "Av. Ejemplo 123, Arequipa",
    "idRol": {{idRolAlmacenista}},
    "passwordUsuario": "{{passwordUsuarios}}"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idAlmacenista", res.body.idUsuario);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Rol correcto", function() {
    expect(res.body.nombreRol).to.equal("ALMACENISTA");
  });

  test("Correo en minusculas", function() {
    expect(res.body.correoUsuario).to.equal(res.body.correoUsuario.toLowerCase());
  });

  test("No devuelve la contrasena", function() {
    expect(res.body).to.not.have.property("passwordUsuario");
  });
}
