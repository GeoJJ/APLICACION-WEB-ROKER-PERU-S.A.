meta {
  name: Crear usuario vendedor3: Andrea Sofia Ramirez Choque (VENDEDOR)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/admin/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreUsuario": "Andrea Sofia Ramirez Choque",
    "correoUsuario": "andrea.ramirez.{{run}}@rokerperu.test",
    "tipoPersonaUsuario": "NATURAL",
    "numeroDocumentoUsuario": "{{dniVendedor3}}",
    "telefonoUsuario": "959123456",
    "direccionUsuario": "Calle Bolivar 312, Cercado, Arequipa",
    "idRol": {{idRolVendedor}},
    "passwordUsuario": "{{passwordUsuarios}}"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idVendedor3", res.body.idUsuario); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Rol correcto", function() {
    expect(res.body.nombreRol).to.equal("VENDEDOR");
  });

  test("Correo en minusculas", function() {
    expect(res.body.correoUsuario).to.equal(res.body.correoUsuario.toLowerCase());
  });

  test("No devuelve la contrasena", function() {
    expect(res.body).to.not.have.property("passwordUsuario");
  });
}
