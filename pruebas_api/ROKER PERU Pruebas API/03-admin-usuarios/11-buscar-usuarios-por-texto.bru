meta {
  name: Buscar usuarios por texto
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/admin/usuarios/buscar?texto={{run}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Devuelve una lista", function() {
    expect(res.body).to.be.an("array");
  });

  test("La lista incluye idCliente", function() {
    const ids = res.body.map(x => Number(x.idUsuario));
    expect(ids).to.include(Number(bru.getVar("idCliente")));
  });
}
