meta {
  name: Crear usuario repartidor3: Luis Enrique Apaza Yucra (REPARTIDOR)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/admin/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreUsuario": "Luis Enrique Apaza Yucra",
    "correoUsuario": "luis.apaza.{{run}}@rokerperu.test",
    "tipoPersonaUsuario": "NATURAL",
    "numeroDocumentoUsuario": "{{dniRepartidor3}}",
    "telefonoUsuario": "958234567",
    "direccionUsuario": "Av. Aviacion 1450, Cerro Colorado, Arequipa",
    "idRol": {{idRolRepartidor}},
    "passwordUsuario": "{{passwordUsuarios}}"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idRepartidor3", res.body.idUsuario); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Rol correcto", function() {
    expect(res.body.nombreRol).to.equal("REPARTIDOR");
  });

  test("Correo en minusculas", function() {
    expect(res.body.correoUsuario).to.equal(res.body.correoUsuario.toLowerCase());
  });

  test("No devuelve la contrasena", function() {
    expect(res.body).to.not.have.property("passwordUsuario");
  });
}
