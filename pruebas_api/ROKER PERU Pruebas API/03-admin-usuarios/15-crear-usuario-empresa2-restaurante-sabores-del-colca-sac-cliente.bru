meta {
  name: Crear usuario empresa2: Restaurante Sabores del Colca SAC (CLIENTE)
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/admin/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreUsuario": "Restaurante Sabores del Colca SAC",
    "correoUsuario": "contacto.sabores.{{run}}@rokerperu.test",
    "tipoPersonaUsuario": "JURIDICA",
    "numeroDocumentoUsuario": "{{rucEmpresa2}}",
    "telefonoUsuario": "954678901",
    "direccionUsuario": "Av. Parra 520, Cercado, Arequipa",
    "idRol": {{idRolCliente}},
    "passwordUsuario": "{{passwordUsuarios}}"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idEmpresa2", res.body.idUsuario); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Rol correcto", function() {
    expect(res.body.nombreRol).to.equal("CLIENTE");
  });

  test("Correo en minusculas", function() {
    expect(res.body.correoUsuario).to.equal(res.body.correoUsuario.toLowerCase());
  });

  test("No devuelve la contrasena", function() {
    expect(res.body).to.not.have.property("passwordUsuario");
  });
}
