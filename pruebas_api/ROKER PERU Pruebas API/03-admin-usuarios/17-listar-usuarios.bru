meta {
  name: Listar usuarios
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/admin/usuarios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Devuelve una lista", function() {
    expect(res.body).to.be.an("array");
  });

  test("La lista incluye idVendedor", function() {
    const ids = res.body.map(x => Number(x.idUsuario));
    expect(ids).to.include(Number(bru.getVar("idVendedor")));
  });

  test("Ningun usuario expone la contrasena", function() {
    expect(res.body.every(u => !("passwordUsuario" in u))).to.equal(true);
  });
}
