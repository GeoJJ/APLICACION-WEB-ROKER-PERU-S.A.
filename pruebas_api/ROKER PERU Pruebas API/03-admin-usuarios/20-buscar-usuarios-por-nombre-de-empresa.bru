meta {
  name: Buscar usuarios por nombre de empresa
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/admin/usuarios/buscar?texto=Constructora
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("La lista incluye idEmpresa3", function() {
    const ids = res.body.map(x => Number(x.idUsuario)); expect(ids).to.include(Number(bru.getVar("idEmpresa3")));
  });
}
