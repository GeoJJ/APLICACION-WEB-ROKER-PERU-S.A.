meta {
  name: Actualizar usuario inexistente
  type: http
  seq: 26
}

put {
  url: {{baseUrl}}/admin/usuarios/999999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreUsuario": "Nadie {{run}}",
    "correoUsuario": "x.{{run}}@rokerperu.test",
    "tipoPersonaUsuario": "NATURAL",
    "numeroDocumentoUsuario": "{{dniTemporal}}",
    "telefonoUsuario": "987654321",
    "direccionUsuario": "Av. Ejemplo 123, Arequipa",
    "idRol": {{idRolCliente}},
    "passwordUsuario": "{{passwordUsuarios}}"
  }
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
