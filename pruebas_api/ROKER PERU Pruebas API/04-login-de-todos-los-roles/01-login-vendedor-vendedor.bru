meta {
  name: Login vendedor (VENDEDOR)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correoUsuario": "carlos.mendoza.{{run}}@rokerperu.test",
    "passwordUsuario": "{{passwordUsuarios}}"
  }
}

script:post-response {
  if (res.status === 200) { bru.setVar("tokenVendedor", res.body.token); }
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Devuelve un token JWT", function() {
    expect(res.body.token.split(".").length).to.equal(3);
  });
}
