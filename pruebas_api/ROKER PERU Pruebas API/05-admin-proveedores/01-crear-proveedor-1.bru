meta {
  name: Crear proveedor 1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/proveedores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreProveedor": "Bioseguridad Andina SAC",
    "rucProveedor": "{{rucProv1}}",
    "telefonoProveedor": "054123456",
    "correoProveedor": "ventas@bioseguridadandina.test"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idProv1", res.body.idProveedor);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Nombre en mayusculas", function() {
    expect(res.body.nombreProveedor).to.equal(res.body.nombreProveedor.toUpperCase());
  });
}
