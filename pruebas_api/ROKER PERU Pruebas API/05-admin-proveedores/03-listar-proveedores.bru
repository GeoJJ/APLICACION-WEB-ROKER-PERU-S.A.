meta {
  name: Listar proveedores
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/admin/proveedores
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Devuelve una lista", function() {
    expect(res.body).to.be.an("array");
  });

  test("La lista incluye idProv1", function() {
    const ids = res.body.map(x => Number(x.idProveedor));
    expect(ids).to.include(Number(bru.getVar("idProv1")));
  });
}
