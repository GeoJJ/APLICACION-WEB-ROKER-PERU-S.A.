meta {
  name: Listar proveedores incluye los nuevos
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/admin/proveedores
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("La lista incluye idProv3", function() {
    const ids = res.body.map(x => Number(x.idProveedor)); expect(ids).to.include(Number(bru.getVar("idProv3")));
  });

  test("La lista incluye idProv4", function() {
    const ids = res.body.map(x => Number(x.idProveedor)); expect(ids).to.include(Number(bru.getVar("idProv4")));
  });
}
