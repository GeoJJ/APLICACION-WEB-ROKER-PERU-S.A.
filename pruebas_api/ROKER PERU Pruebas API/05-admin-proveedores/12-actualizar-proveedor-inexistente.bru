meta {
  name: Actualizar proveedor inexistente
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/admin/proveedores/999999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreProveedor": "Nadie",
    "rucProveedor": "{{rucProvDup}}",
    "telefonoProveedor": "054123456",
    "correoProveedor": "ventas{{run}}@proveedor.test"
  }
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
