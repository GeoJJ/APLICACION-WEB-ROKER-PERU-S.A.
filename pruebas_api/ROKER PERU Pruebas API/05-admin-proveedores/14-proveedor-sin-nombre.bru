meta {
  name: Proveedor sin nombre
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/admin/proveedores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreProveedor": "",
    "rucProveedor": "{{rucProvDup}}",
    "telefonoProveedor": "054123456",
    "correoProveedor": "ventas{{run}}@proveedor.test"
  }
}

tests {
  test("Responde 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Cuerpo de error con status 400", function() {
    expect(res.body.status).to.equal(400);
  });
}
