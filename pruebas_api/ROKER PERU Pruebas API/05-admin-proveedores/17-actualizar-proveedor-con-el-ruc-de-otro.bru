meta {
  name: Actualizar proveedor con el RUC de otro
  type: http
  seq: 17
}

put {
  url: {{baseUrl}}/admin/proveedores/{{idProv2}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreProveedor": "Quimicos del Sur",
    "rucProveedor": "{{rucProv1}}",
    "telefonoProveedor": "054123456",
    "correoProveedor": "ventas{{run}}@proveedor.test"
  }
}

tests {
  test("Responde 409", function() {
    expect(res.status).to.equal(409);
  });

  test("Cuerpo de error con status 409", function() {
    expect(res.body.status).to.equal(409);
  });
}
