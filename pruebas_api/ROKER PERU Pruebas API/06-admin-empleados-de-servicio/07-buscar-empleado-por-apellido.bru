meta {
  name: Buscar empleado por apellido
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/admin/empleados-servicio/buscar?texto=Quispe
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("La lista incluye idEmp1", function() {
    const ids = res.body.map(x => Number(x.idEmpleadoServicio));
    expect(ids).to.include(Number(bru.getVar("idEmp1")));
  });
}
