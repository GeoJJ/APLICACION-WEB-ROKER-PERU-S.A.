meta {
  name: Crear empleado 7: Sandra Milagros Choque Anco
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/admin/empleados-servicio
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreEmpleadoServicio": "Sandra Milagros",
    "apellidoEmpleadoServicio": "Choque Anco",
    "telefonoEmpleadoServicio": "986222333"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idEmp7", res.body.idEmpleadoServicio); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Nombre y apellido en mayusculas", function() {
    expect(res.body.nombreEmpleadoServicio).to.equal(res.body.nombreEmpleadoServicio.toUpperCase());
  });
}
