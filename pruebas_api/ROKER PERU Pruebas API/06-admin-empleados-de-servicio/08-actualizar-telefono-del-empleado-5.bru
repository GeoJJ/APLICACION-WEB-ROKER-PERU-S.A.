meta {
  name: Actualizar telefono del empleado 5
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/admin/empleados-servicio/{{idEmp5}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreEmpleadoServicio": "Juan Carlos",
    "apellidoEmpleadoServicio": "Flores",
    "telefonoEmpleadoServicio": "955444333"
  }
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Telefono actualizado", function() {
    expect(res.body.telefonoEmpleadoServicio).to.equal("955444333");
  });
}
