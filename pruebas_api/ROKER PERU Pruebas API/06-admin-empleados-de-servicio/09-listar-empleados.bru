meta {
  name: Listar empleados
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/admin/empleados-servicio
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Devuelve una lista", function() {
    expect(res.body).to.be.an("array");
  });

  test("La lista incluye idEmp1", function() {
    const ids = res.body.map(x => Number(x.idEmpleadoServicio));
    expect(ids).to.include(Number(bru.getVar("idEmp1")));
  });
}
