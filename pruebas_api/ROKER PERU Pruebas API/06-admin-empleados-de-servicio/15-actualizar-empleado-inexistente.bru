meta {
  name: Actualizar empleado inexistente
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/admin/empleados-servicio/999999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombreEmpleadoServicio": "A",
    "apellidoEmpleadoServicio": "B",
    "telefonoEmpleadoServicio": "987000111"
  }
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
