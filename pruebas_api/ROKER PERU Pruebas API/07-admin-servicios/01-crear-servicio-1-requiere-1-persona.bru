meta {
  name: Crear servicio 1 (requiere 1 persona)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/servicios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "categoriaServicio": "limpieza",
    "nombreServicio": "Limpieza integral de oficinas",
    "tipoServicio": "preventivo",
    "descripcionServicio": "Limpieza y desinfeccion de pisos, escritorios, banos y areas comunes",
    "precioServicio": 150.0,
    "duracionEstimadaServicio": "4 horas",
    "cantidadPersonalServicio": "1"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idServicio1", res.body.idServicio);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaServicio).to.equal("LIMPIEZA");
  });

  test("Precio", function() {
    expect(res.body.precioServicio).to.equal(150);
  });
}
