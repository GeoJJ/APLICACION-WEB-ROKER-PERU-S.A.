meta {
  name: Crear servicio 2 (requiere 2 personas)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/servicios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "categoriaServicio": "bioseguridad",
    "nombreServicio": "Fumigacion y control de plagas {{run}}",
    "tipoServicio": "preventivo",
    "descripcionServicio": "Servicio de prueba automatizada",
    "precioServicio": 400.0,
    "duracionEstimadaServicio": "4 horas",
    "cantidadPersonalServicio": "2"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idServicio2", res.body.idServicio);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Precio", function() {
    expect(res.body.precioServicio).to.equal(400);
  });
}
