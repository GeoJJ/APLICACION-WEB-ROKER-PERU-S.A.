meta {
  name: Crear servicio 3: Desinfeccion de ambientes con nebulizacion
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/servicios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "categoriaServicio": "desinfeccion",
    "nombreServicio": "Desinfeccion de ambientes con nebulizacion",
    "tipoServicio": "preventivo",
    "descripcionServicio": "Nebulizacion con amonio cuaternario para oficinas, aulas y consultorios",
    "precioServicio": 280.0,
    "duracionEstimadaServicio": "3 horas",
    "cantidadPersonalServicio": "2"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idServicio3", res.body.idServicio); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaServicio).to.equal("DESINFECCION");
  });

  test("Precio", function() {
    expect(res.body.precioServicio).to.equal(280);
  });
}
