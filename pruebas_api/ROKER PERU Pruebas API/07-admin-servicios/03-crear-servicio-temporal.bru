meta {
  name: Crear servicio temporal
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/servicios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "categoriaServicio": "limpieza",
    "nombreServicio": "Servicio Temporal {{run}}",
    "tipoServicio": "preventivo",
    "descripcionServicio": "Servicio de prueba automatizada",
    "precioServicio": 10.0,
    "duracionEstimadaServicio": "4 horas",
    "cantidadPersonalServicio": "1"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idServicioTemp", res.body.idServicio);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });
}
