meta {
  name: Crear servicio 4: Fumigacion de almacenes y depositos
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/admin/servicios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "categoriaServicio": "control de plagas",
    "nombreServicio": "Fumigacion de almacenes y depositos",
    "tipoServicio": "preventivo",
    "descripcionServicio": "Control de roedores e insectos rastreros en almacenes con certificado",
    "precioServicio": 450.0,
    "duracionEstimadaServicio": "5 horas",
    "cantidadPersonalServicio": "3"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idServicio4", res.body.idServicio); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaServicio).to.equal("CONTROL DE PLAGAS");
  });

  test("Precio", function() {
    expect(res.body.precioServicio).to.equal(450);
  });
}
