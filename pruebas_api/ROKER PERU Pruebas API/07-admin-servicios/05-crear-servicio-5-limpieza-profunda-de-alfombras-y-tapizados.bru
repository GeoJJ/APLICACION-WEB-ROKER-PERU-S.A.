meta {
  name: Crear servicio 5: Limpieza profunda de alfombras y tapizados
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admin/servicios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "categoriaServicio": "limpieza",
    "nombreServicio": "Limpieza profunda de alfombras y tapizados",
    "tipoServicio": "correctivo",
    "descripcionServicio": "Lavado por inyeccion y succion de alfombras, sofas y sillas",
    "precioServicio": 220.0,
    "duracionEstimadaServicio": "4 horas",
    "cantidadPersonalServicio": "2"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idServicio5", res.body.idServicio); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaServicio).to.equal("LIMPIEZA");
  });

  test("Precio", function() {
    expect(res.body.precioServicio).to.equal(220);
  });
}
