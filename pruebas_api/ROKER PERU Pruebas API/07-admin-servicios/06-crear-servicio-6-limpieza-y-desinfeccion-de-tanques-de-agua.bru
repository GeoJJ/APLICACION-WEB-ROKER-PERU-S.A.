meta {
  name: Crear servicio 6: Limpieza y desinfeccion de tanques de agua
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/admin/servicios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "categoriaServicio": "limpieza",
    "nombreServicio": "Limpieza y desinfeccion de tanques de agua",
    "tipoServicio": "preventivo",
    "descripcionServicio": "Vaciado, cepillado, desinfeccion y llenado de tanques y cisternas",
    "precioServicio": 350.0,
    "duracionEstimadaServicio": "6 horas",
    "cantidadPersonalServicio": "2"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idServicio6", res.body.idServicio); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaServicio).to.equal("LIMPIEZA");
  });

  test("Precio", function() {
    expect(res.body.precioServicio).to.equal(350);
  });
}
