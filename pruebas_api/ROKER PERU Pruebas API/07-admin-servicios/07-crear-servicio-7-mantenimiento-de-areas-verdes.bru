meta {
  name: Crear servicio 7: Mantenimiento de areas verdes
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/admin/servicios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "categoriaServicio": "jardineria",
    "nombreServicio": "Mantenimiento de areas verdes",
    "tipoServicio": "preventivo",
    "descripcionServicio": "Corte de cesped, poda de arbustos y limpieza de jardines",
    "precioServicio": 180.0,
    "duracionEstimadaServicio": "4 horas",
    "cantidadPersonalServicio": "1"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idServicio7", res.body.idServicio); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaServicio).to.equal("JARDINERIA");
  });

  test("Precio", function() {
    expect(res.body.precioServicio).to.equal(180);
  });
}
