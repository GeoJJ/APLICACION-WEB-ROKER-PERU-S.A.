meta {
  name: Crear servicio 8: Capacitacion en bioseguridad para personal
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/admin/servicios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "categoriaServicio": "capacitacion",
    "nombreServicio": "Capacitacion en bioseguridad para personal",
    "tipoServicio": "preventivo",
    "descripcionServicio": "Charla practica de uso de EPP y protocolos de bioseguridad",
    "precioServicio": 600.0,
    "duracionEstimadaServicio": "3 horas",
    "cantidadPersonalServicio": "1"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idServicio8", res.body.idServicio); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaServicio).to.equal("CAPACITACION");
  });

  test("Precio", function() {
    expect(res.body.precioServicio).to.equal(600);
  });
}
