meta {
  name: Actualizar servicio inexistente
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/admin/servicios/999999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "categoriaServicio": "limpieza",
    "nombreServicio": "X",
    "tipoServicio": "preventivo",
    "descripcionServicio": "Servicio de prueba automatizada",
    "precioServicio": 1.0,
    "duracionEstimadaServicio": "4 horas",
    "cantidadPersonalServicio": "1"
  }
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
