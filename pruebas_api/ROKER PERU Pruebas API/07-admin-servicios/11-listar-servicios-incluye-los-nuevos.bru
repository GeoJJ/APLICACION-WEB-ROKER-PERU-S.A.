meta {
  name: Listar servicios incluye los nuevos
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/admin/servicios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("La lista incluye idServicio3", function() {
    const ids = res.body.map(x => Number(x.idServicio)); expect(ids).to.include(Number(bru.getVar("idServicio3")));
  });

  test("La lista incluye idServicio4", function() {
