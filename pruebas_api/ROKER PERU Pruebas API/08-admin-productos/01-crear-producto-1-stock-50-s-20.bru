meta {
  name: Crear producto 1 (stock 50, S/ 20)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-1",
    "nombreProducto": "Mascarilla KN95 {{run}}",
    "categoriaProducto": "bioseguridad",
    "precioProducto": 20.0,
    "stockProducto": 50,
    "stockMinimo": 10,
    "estadoProducto": "activo",
    "idProveedor": {{idProv1}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idProd1", res.body.idProducto);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock inicial", function() {
    expect(res.body.stockProducto).to.equal(50);
  });

  test("Estado en mayusculas", function() {
    expect(res.body.estadoProducto).to.equal("ACTIVO");
  });
}
