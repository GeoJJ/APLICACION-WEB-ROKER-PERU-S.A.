meta {
  name: Crear producto 2 (stock 30, S/ 18.50)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-2",
    "nombreProducto": "Alcohol en gel 1L",
    "categoriaProducto": "bioseguridad",
    "precioProducto": 18.5,
    "stockProducto": 30,
    "stockMinimo": 10,
    "estadoProducto": "activo",
    "idProveedor": {{idProv1}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idProd2", res.body.idProducto);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock inicial", function() {
    expect(res.body.stockProducto).to.equal(30);
  });
}
