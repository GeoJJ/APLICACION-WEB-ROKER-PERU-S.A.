meta {
  name: Crear producto 3 (stock 100, S/ 100)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-3",
    "nombreProducto": "Traje Tyvek descartable talla L",
    "categoriaProducto": "bioseguridad",
    "precioProducto": 100.0,
    "stockProducto": 100,
    "stockMinimo": 20,
    "estadoProducto": "activo",
    "idProveedor": {{idProv2}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idProd3", res.body.idProducto);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Proveedor asignado", function() {
    expect(res.body.nombreProveedor.length > 0).to.equal(true);
  });
}
