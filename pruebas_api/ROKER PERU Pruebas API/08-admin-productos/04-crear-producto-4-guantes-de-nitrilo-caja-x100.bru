meta {
  name: Crear producto 4: Guantes de nitrilo caja x100
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-4",
    "nombreProducto": "Guantes de nitrilo caja x100",
    "categoriaProducto": "bioseguridad",
    "precioProducto": 38.0,
    "stockProducto": 80,
    "stockMinimo": 15,
    "estadoProducto": "activo",
    "idProveedor": {{idProv1}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idProd4", res.body.idProducto); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock inicial", function() {
    expect(res.body.stockProducto).to.equal(80);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaProducto).to.equal("BIOSEGURIDAD");
  });

  test("Estado ACTIVO", function() {
    expect(res.body.estadoProducto).to.equal("ACTIVO");
  });
}
