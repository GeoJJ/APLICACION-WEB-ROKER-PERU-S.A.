meta {
  name: Crear producto temporal
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-T",
    "nombreProducto": "Producto Temporal {{run}}",
    "categoriaProducto": "bioseguridad",
    "precioProducto": 5.0,
    "stockProducto": 1,
    "stockMinimo": 0,
    "estadoProducto": "activo",
    "idProveedor": {{idProv1}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idProdTemp", res.body.idProducto);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });
}
