meta {
  name: Crear producto 6: Respirador N95 con valvula
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-6",
    "nombreProducto": "Respirador N95 con valvula",
    "categoriaProducto": "bioseguridad",
    "precioProducto": 12.5,
    "stockProducto": 60,
    "stockMinimo": 10,
    "estadoProducto": "activo",
    "idProveedor": {{idProv1}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idProd6", res.body.idProducto); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock inicial", function() {
    expect(res.body.stockProducto).to.equal(60);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaProducto).to.equal("BIOSEGURIDAD");
  });

  test("Estado ACTIVO", function() {
    expect(res.body.estadoProducto).to.equal("ACTIVO");
  });
}
