meta {
  name: Crear producto 8: Casco de seguridad industrial
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-8",
    "nombreProducto": "Casco de seguridad industrial",
    "categoriaProducto": "epp",
    "precioProducto": 24.0,
    "stockProducto": 40,
    "stockMinimo": 8,
    "estadoProducto": "activo",
    "idProveedor": {{idProv3}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idProd8", res.body.idProducto); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock inicial", function() {
    expect(res.body.stockProducto).to.equal(40);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaProducto).to.equal("EPP");
  });

  test("Estado ACTIVO", function() {
    expect(res.body.estadoProducto).to.equal("ACTIVO");
  });
}
