meta {
  name: Crear producto 9: Botas de jebe punta de acero
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-9",
    "nombreProducto": "Botas de jebe punta de acero",
    "categoriaProducto": "epp",
    "precioProducto": 69.9,
    "stockProducto": 25,
    "stockMinimo": 5,
    "estadoProducto": "activo",
    "idProveedor": {{idProv3}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idProd9", res.body.idProducto); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock inicial", function() {
    expect(res.body.stockProducto).to.equal(25);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaProducto).to.equal("EPP");
  });

  test("Estado ACTIVO", function() {
    expect(res.body.estadoProducto).to.equal("ACTIVO");
  });
}
