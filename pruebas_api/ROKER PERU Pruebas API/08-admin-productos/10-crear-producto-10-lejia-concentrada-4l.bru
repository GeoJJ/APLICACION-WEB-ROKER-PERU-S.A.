meta {
  name: Crear producto 10: Lejia concentrada 4L
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-10",
    "nombreProducto": "Lejia concentrada 4L",
    "categoriaProducto": "limpieza",
    "precioProducto": 14.5,
    "stockProducto": 70,
    "stockMinimo": 12,
    "estadoProducto": "activo",
    "idProveedor": {{idProv4}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idProd10", res.body.idProducto); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock inicial", function() {
    expect(res.body.stockProducto).to.equal(70);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaProducto).to.equal("LIMPIEZA");
  });

  test("Estado ACTIVO", function() {
    expect(res.body.estadoProducto).to.equal("ACTIVO");
  });
}
