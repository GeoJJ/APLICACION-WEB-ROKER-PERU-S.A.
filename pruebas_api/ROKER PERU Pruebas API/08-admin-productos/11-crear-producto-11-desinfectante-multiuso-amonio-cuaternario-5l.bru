meta {
  name: Crear producto 11: Desinfectante multiuso amonio cuaternario 5L
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-11",
    "nombreProducto": "Desinfectante multiuso amonio cuaternario 5L",
    "categoriaProducto": "limpieza",
    "precioProducto": 46.0,
    "stockProducto": 35,
    "stockMinimo": 8,
    "estadoProducto": "activo",
    "idProveedor": {{idProv4}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idProd11", res.body.idProducto); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock inicial", function() {
    expect(res.body.stockProducto).to.equal(35);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaProducto).to.equal("LIMPIEZA");
  });

  test("Estado ACTIVO", function() {
    expect(res.body.estadoProducto).to.equal("ACTIVO");
  });
}
