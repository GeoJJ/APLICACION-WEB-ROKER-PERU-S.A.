meta {
  name: Crear producto 12: Jabon liquido antibacterial 1L
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "PRD-{{run}}-12",
    "nombreProducto": "Jabon liquido antibacterial 1L",
    "categoriaProducto": "limpieza",
    "precioProducto": 11.8,
    "stockProducto": 90,
    "stockMinimo": 15,
    "estadoProducto": "activo",
    "idProveedor": {{idProv4}}
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idProd12", res.body.idProducto); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock inicial", function() {
    expect(res.body.stockProducto).to.equal(90);
  });

  test("Categoria en mayusculas", function() {
    expect(res.body.categoriaProducto).to.equal("LIMPIEZA");
  });

  test("Estado ACTIVO", function() {
    expect(res.body.estadoProducto).to.equal("ACTIVO");
  });
}
