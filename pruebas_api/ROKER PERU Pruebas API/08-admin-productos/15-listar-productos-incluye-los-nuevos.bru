meta {
  name: Listar productos incluye los nuevos
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/admin/productos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("La lista incluye idProd4", function() {
    const ids = res.body.map(x => Number(x.idProducto)); expect(ids).to.include(Number(bru.getVar("idProd4")));
  });

