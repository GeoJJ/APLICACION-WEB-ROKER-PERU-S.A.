meta {
  name: Producto sin codigo
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/admin/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "codigoProducto": "",
    "nombreProducto": "Malo",
    "categoriaProducto": "bioseguridad",
    "precioProducto": 5.0,
    "stockProducto": 1,
    "stockMinimo": 0,
    "estadoProducto": "activo",
    "idProveedor": {{idProv1}}
  }
}

tests {
  test("Responde 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Cuerpo de error con status 400", function() {
    expect(res.body.status).to.equal(400);
  });
}
