meta {
  name: Stock inicial del producto 2 (30)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/inventario/stock/{{idProd2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Stock = 30", function() {
    expect(res.body).to.equal(30);
  });
}
