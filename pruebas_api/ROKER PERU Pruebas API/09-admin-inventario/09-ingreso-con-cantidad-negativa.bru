meta {
  name: Ingreso con cantidad negativa
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/admin/inventario/ingreso
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "productoId": {{idProd2}},
    "cantidad": -3,
    "tipoMovimiento": "INGRESO",
    "justificacion": "Prueba automatizada"
  }
}

tests {
  test("Responde 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Cuerpo de error con status 400", function() {
    expect(res.body.status).to.equal(400);
  });
}
