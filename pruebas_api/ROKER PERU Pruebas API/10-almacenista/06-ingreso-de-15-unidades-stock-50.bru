meta {
  name: Ingreso de 15 unidades (stock 50)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/almacenista/inventario/ingreso
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAlmacenista}}
}

body:json {
  {
    "productoId": {{idProd2}},
    "cantidad": 15,
    "tipoMovimiento": "INGRESO",
    "justificacion": "Prueba automatizada"
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock resultante 50", function() {
    expect(res.body.stockResultante).to.equal(50);
  });
}
