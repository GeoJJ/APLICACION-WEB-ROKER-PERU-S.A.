meta {
  name: Bajar el stock a 3 (CRITICO)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/almacenista/inventario/ajuste
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAlmacenista}}
}

body:json {
  {
    "productoId": {{idProd2}},
    "cantidad": 47,
    "tipoMovimiento": "AJUSTE",
    "justificacion": "Prueba automatizada"
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock resultante 3", function() {
    expect(res.body.stockResultante).to.equal(3);
  });
}
