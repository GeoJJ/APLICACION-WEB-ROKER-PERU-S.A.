meta {
  name: Bajar el stock a 0 (AGOTADO)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/almacenista/inventario/ajuste
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAlmacenista}}
}

body:json {
  {
    "productoId": {{idProd2}},
    "cantidad": 3,
    "tipoMovimiento": "AJUSTE",
    "justificacion": "Prueba automatizada"
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Stock resultante 0", function() {
    expect(res.body.stockResultante).to.equal(0);
  });
}
