meta {
  name: Ajuste con cantidad 0
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/almacenista/inventario/ajuste
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAlmacenista}}
}

body:json {
  {
    "productoId": {{idProd2}},
    "cantidad": 0,
    "tipoMovimiento": "AJUSTE",
    "justificacion": "Prueba automatizada"
  }
}

tests {
  test("Responde 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Cuerpo de error con status 400", function() {
    expect(res.body.status).to.equal(400);
  });
}
