meta {
  name: Ingreso de un producto inexistente
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/almacenista/inventario/ingreso
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAlmacenista}}
}

body:json {
  {
    "productoId": 999999,
    "cantidad": 1
  }
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
