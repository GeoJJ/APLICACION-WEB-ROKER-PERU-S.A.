meta {
  name: Ver un servicio
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/vendedor/servicios/{{idServicio1}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Precio 150", function() {
    expect(res.body.precioServicio).to.equal(150);
  });
}
