meta {
  name: Ver repartidores disponibles
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/vendedor/repartidores
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Devuelve una lista", function() {
    expect(res.body).to.be.an("array");
  });

  test("La lista incluye idRepartidor", function() {
    const ids = res.body.map(x => Number(x.idUsuario));
    expect(ids).to.include(Number(bru.getVar("idRepartidor")));
  });

  test("La lista incluye idRepartidor2", function() {
    const ids = res.body.map(x => Number(x.idUsuario));
    expect(ids).to.include(Number(bru.getVar("idRepartidor2")));
  });

  test("Solo trae repartidores", function() {
    expect(res.body.every(u => u.nombreRol === "REPARTIDOR")).to.equal(true);
  });

  test("No expone contrasenas", function() {
    expect(res.body.every(u => !("passwordUsuario" in u))).to.equal(true);
  });
}
