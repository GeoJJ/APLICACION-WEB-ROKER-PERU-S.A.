meta {
  name: Salida mayor al stock disponible
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/vendedor/inventario/salida
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

body:json {
  {
    "productoId": {{idProd2}},
    "cantidad": 999,
    "tipoMovimiento": "SALIDA",
    "justificacion": "Prueba automatizada"
  }
}

tests {
  test("Responde 409", function() {
    expect(res.status).to.equal(409);
  });

  test("Cuerpo de error con status 409", function() {
    expect(res.body.status).to.equal(409);
  });

  test("Informa el stock disponible", function() {
    expect(res.body.stockDisponible).to.equal(30);
  });
}
