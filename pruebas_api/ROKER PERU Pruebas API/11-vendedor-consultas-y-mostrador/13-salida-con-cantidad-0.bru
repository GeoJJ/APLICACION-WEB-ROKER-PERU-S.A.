meta {
  name: Salida con cantidad 0
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/vendedor/inventario/salida
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

body:json {
  {
    "productoId": {{idProd2}},
    "cantidad": 0,
    "tipoMovimiento": "SALIDA",
    "justificacion": "Prueba automatizada"
  }
}

tests {
  test("Responde 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Cuerpo de error con status 400", function() {
    expect(res.body.status).to.equal(400);
  });
}
