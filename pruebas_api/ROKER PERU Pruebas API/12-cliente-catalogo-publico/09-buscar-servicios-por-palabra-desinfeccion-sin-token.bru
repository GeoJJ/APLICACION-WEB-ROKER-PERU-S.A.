meta {
  name: Buscar servicios por palabra desinfeccion sin token
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/cliente/servicios/buscar?texto=desinfeccion
  body: none
  auth: none
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("La lista incluye idServicio3", function() {
    const ids = res.body.map(x => Number(x.idServicio)); expect(ids).to.include(Number(bru.getVar("idServicio3")));
  });

  test("La lista incluye idServicio6", function() {
    const ids = res.body.map(x => Number(x.idServicio)); expect(ids).to.include(Number(bru.getVar("idServicio6")));
  });
}
