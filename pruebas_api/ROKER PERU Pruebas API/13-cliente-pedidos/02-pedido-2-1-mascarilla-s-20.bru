meta {
  name: Pedido 2: 1 mascarilla (S/ 20)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/cliente/pedidos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "metodoPagoPedido": "yape",
    "detalles": [
      {
        "idProducto": {{idProd1}},
        "cantidadProducto": 1
      }
    ]
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idPedido2", res.body.idPedido);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Monto S/ 20", function() {
    expect(res.body.montoTotalPedido).to.be.closeTo(20, 0.01);
  });
}
