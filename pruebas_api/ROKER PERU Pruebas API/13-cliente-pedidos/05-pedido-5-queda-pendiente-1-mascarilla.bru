meta {
  name: Pedido 5 (queda pendiente): 1 mascarilla
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/cliente/pedidos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "metodoPagoPedido": "efectivo",
    "detalles": [
      {
        "idProducto": {{idProd1}},
        "cantidadProducto": 1
      }
    ]
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idPedido5", res.body.idPedido);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });
}
