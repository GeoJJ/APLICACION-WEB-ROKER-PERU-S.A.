meta {
  name: Pedido que supera el stock
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/cliente/pedidos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "metodoPagoPedido": "efectivo",
    "detalles": [
      {
        "idProducto": {{idProd1}},
        "cantidadProducto": 9999
      }
    ]
  }
}

tests {
  test("Responde 409", function() {
    expect(res.status).to.equal(409);
  });

  test("Cuerpo de error con status 409", function() {
    expect(res.body.status).to.equal(409);
  });

  test("Informa el stock disponible", function() {
    expect(res.body.stockDisponible).to.equal(45);
  });
}
