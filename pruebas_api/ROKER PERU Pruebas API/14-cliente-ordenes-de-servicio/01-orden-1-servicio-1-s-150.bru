meta {
  name: Orden 1: servicio 1 (S/ 150)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/cliente/ordenes-servicio
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "idServicio": {{idServicio1}},
    "fechaProgramadaServicio": "2030-03-10T09:00:00",
    "metodoPagoServicio": "transferencia",
    "incidenciaServicio": "Ingresar por la puerta lateral"
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar("idOrden1", res.body.idOrdenServicio);
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Estado PENDIENTE", function() {
    expect(res.body.estadoServicio).to.equal("PENDIENTE");
  });

  test("Monto S/ 150", function() {
    expect(res.body.montoTotalServicio).to.be.closeTo(150, 0.01);
  });

  test("Metodo de pago normalizado", function() {
    expect(res.body.metodoPagoServicio).to.equal("TRANSFERENCIA");
  });

  test("Aun sin comprobante", function() {
    expect(res.body.serieComprobanteServicio).to.equal(null);
  });
}
