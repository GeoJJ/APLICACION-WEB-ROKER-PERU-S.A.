meta {
  name: Ver una orden inexistente
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/cliente/ordenes-servicio/999999
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

tests {
  test("Responde 409", function() {
    expect(res.status).to.equal(409);
  });

  test("Cuerpo de error con status 409", function() {
    expect(res.body.status).to.equal(409);
  });
}
