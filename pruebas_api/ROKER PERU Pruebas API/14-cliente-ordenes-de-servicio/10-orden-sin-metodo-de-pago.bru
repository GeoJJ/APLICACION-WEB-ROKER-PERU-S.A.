meta {
  name: Orden sin metodo de pago
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/cliente/ordenes-servicio
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "idServicio": {{idServicio1}},
    "fechaProgramadaServicio": "2030-03-10T09:00:00",
    "incidenciaServicio": "Ingresar por la puerta lateral"
  }
}

tests {
  test("Responde 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Cuerpo de error con status 400", function() {
    expect(res.body.status).to.equal(400);
  });
}
