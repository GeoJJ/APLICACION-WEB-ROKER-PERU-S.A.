meta {
  name: Orden de un servicio inexistente
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/cliente/ordenes-servicio
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "idServicio": 999999,
    "fechaProgramadaServicio": "2030-03-10T09:00:00",
    "metodoPagoServicio": "transferencia",
    "incidenciaServicio": "Ingresar por la puerta lateral"
  }
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
