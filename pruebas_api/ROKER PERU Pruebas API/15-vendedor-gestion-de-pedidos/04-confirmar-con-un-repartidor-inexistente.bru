meta {
  name: Confirmar con un repartidor inexistente
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/vendedor/pedidos/{{idPedido2}}/confirmar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

body:json {
  {
    "idDelivery": 999999
  }
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
