meta {
  name: Confirmar pedido 3 (empresa -> factura) con repartidor 2
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/vendedor/pedidos/{{idPedido3}}/confirmar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

body:json {
  {
    "idDelivery": {{idRepartidor2}}
  }
}

script:post-response {
  if (res.status === 200) { bru.setVar("compPedido3", res.body.serieComprobantePedido + "-" + res.body.numeroComprobantePedido); }
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Serie F001 y numero de 8 digitos", function() {
    expect(res.body.serieComprobantePedido).to.equal("F001");
    expect(res.body.numeroComprobantePedido).to.match(/^\d{8}$/);
  });

  test("Fecha de emision presente", function() {
    expect(res.body.fechaEmisionComprobante).to.exist;
  });
}
