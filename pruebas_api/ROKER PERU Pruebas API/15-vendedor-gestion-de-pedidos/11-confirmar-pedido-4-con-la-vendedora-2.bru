meta {
  name: Confirmar pedido 4 con la vendedora 2
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/vendedor/pedidos/{{idPedido4}}/confirmar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor2}}
}

body:json {
  {
    "idDelivery": {{idRepartidor}}
  }
}

script:post-response {
  if (res.status === 200) { bru.setVar("compPedido4", res.body.serieComprobantePedido + "-" + res.body.numeroComprobantePedido); }
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Vendedora 2 asignada", function() {
    expect(res.body.idVendedor).to.equal(Number(bru.getVar("idVendedor2")));
  });

  test("Serie B001 y numero de 8 digitos", function() {
    expect(res.body.serieComprobantePedido).to.equal("B001");
    expect(res.body.numeroComprobantePedido).to.match(/^\d{8}$/);
  });

  test("Fecha de emision presente", function() {
    expect(res.body.fechaEmisionComprobante).to.exist;
  });
}
