meta {
  name: Asignacion sin responsable
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/vendedor/asignaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

body:json {
  {
    "idOrdenServicio": {{idOrden1}},
    "idEmpleado": {{idEmp2}},
    "nombreResponsableAsignacion": "",
    "descripcionAsignacion": "Limpieza general del area"
  }
}

tests {
  test("Responde 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Cuerpo de error con status 400", function() {
    expect(res.body.status).to.equal(400);
  });
}
