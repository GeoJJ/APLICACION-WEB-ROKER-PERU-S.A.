meta {
  name: Ver todas las asignaciones
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/vendedor/asignaciones
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Devuelve una lista", function() {
    expect(res.body).to.be.an("array");
  });

  test("La lista incluye idAsig1", function() {
    const ids = res.body.map(x => Number(x.idAsignacion));
    expect(ids).to.include(Number(bru.getVar("idAsig1")));
  });
}
