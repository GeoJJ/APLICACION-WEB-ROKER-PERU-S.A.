meta {
  name: Ver una asignacion por id
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/vendedor/asignaciones/{{idAsig1}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Es de la orden 1", function() {
    expect(res.body.idOrdenServicio).to.equal(Number(bru.getVar("idOrden1")));
  });
}
