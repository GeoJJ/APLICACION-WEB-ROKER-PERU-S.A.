meta {
  name: Ver una asignacion inexistente
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/vendedor/asignaciones/999999
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
