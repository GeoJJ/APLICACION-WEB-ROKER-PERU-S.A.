meta {
  name: Confirmar otra vez la orden 1 la completa (servicio realizado)
  type: http
  seq: 19
}

put {
  url: {{baseUrl}}/vendedor/ordenes-servicio/{{idOrden1}}/confirmar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Estado COMPLETADO", function() {
    expect(res.body.estadoServicio).to.equal("COMPLETADO");
  });

  test("Conserva su comprobante B002", function() {
    expect(res.body.serieComprobanteServicio).to.equal("B002");
  });
}
