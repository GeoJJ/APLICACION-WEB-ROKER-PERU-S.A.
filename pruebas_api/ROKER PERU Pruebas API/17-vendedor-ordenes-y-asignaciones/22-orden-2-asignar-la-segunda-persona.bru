meta {
  name: Orden 2: asignar la segunda persona
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/vendedor/asignaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

body:json {
  {
    "idOrdenServicio": {{idOrden2}},
    "idEmpleado": {{idEmp3}},
    "nombreResponsableAsignacion": "Carlos Alberto Mendoza Rojas",
    "descripcionAsignacion": "Limpieza general del area"
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });
}
