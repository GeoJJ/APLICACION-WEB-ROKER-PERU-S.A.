meta {
  name: Confirmar una orden inexistente
  type: http
  seq: 26
}

put {
  url: {{baseUrl}}/vendedor/ordenes-servicio/999999/confirmar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
