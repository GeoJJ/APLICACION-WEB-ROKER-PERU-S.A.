meta {
  name: El cliente ve sus ordenes con el comprobante
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/cliente/ordenes-servicio
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Orden 1 confirmada con comprobante B002", function() {
    const o = res.body.find(x => Number(x.idOrdenServicio) === Number(bru.getVar("idOrden1")));
    expect(o.estadoServicio).to.equal("CONFIRMADO");
    expect(o.serieComprobanteServicio).to.equal("B002");
    expect(o.nombreVendedor).to.contain("Carlos Alberto Mendoza Rojas");
  });

  test("Orden 3 cancelada", function() {
    const o = res.body.find(x => Number(x.idOrdenServicio) === Number(bru.getVar("idOrden3")));
    expect(o.estadoServicio).to.equal("CANCELADO");
  });
}
