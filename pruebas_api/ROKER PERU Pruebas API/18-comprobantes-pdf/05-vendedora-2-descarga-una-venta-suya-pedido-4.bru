meta {
  name: Vendedora 2 descarga una venta suya (pedido 4)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/comprobantes/pedidos/{{idPedido4}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor2}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Es un PDF", function() {
    expect(res.getHeader("content-type")).to.contain("application/pdf");
  });

  test("Nombre de archivo correcto", function() {
    expect(res.getHeader("content-disposition")).to.contain("comprobante-" + bru.getVar("compPedido4"));
  });

  test("El PDF no esta vacio", function() {
    expect(res.getSize().body).to.be.greaterThan(1000);
  });
}
