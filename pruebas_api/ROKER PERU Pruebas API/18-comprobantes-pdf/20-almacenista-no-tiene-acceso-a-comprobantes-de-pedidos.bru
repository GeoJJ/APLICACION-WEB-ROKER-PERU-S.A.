meta {
  name: Almacenista no tiene acceso a comprobantes de pedidos
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/comprobantes/pedidos/{{idPedido1}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAlmacenista}}
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
