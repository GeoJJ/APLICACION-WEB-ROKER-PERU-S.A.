meta {
  name: Repartidor no tiene acceso a comprobantes de servicios
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/comprobantes/ordenes-servicio/{{idOrden1}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenRepartidor}}
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
