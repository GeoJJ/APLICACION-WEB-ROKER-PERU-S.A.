meta {
  name: Comprobante de una orden inexistente
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/comprobantes/ordenes-servicio/999999
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 404", function() {
    expect(res.status).to.equal(404);
  });

  test("Cuerpo de error con status 404", function() {
    expect(res.body.status).to.equal(404);
  });
}
