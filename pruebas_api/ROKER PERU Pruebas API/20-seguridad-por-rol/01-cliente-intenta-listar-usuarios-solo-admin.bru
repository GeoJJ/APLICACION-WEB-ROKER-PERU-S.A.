meta {
  name: Cliente intenta listar usuarios (solo admin)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/usuarios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
