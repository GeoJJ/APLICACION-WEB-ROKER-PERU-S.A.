meta {
  name: Vendedor intenta registrar un ingreso de admin
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/admin/inventario/ingreso
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

body:json {
  {
    "productoId": {{idProd1}},
    "cantidad": 1,
    "tipoMovimiento": "INGRESO",
    "justificacion": "Prueba automatizada"
  }
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
