meta {
  name: Cliente intenta registrar una salida de inventario
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/vendedor/inventario/salida
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "productoId": {{idProd1}},
    "cantidad": 1,
    "tipoMovimiento": "SALIDA",
    "justificacion": "Prueba automatizada"
  }
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
