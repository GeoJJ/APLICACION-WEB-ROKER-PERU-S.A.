meta {
  name: Vendedor intenta ver las alertas del almacenista
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/almacenista/inventario/alertas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
