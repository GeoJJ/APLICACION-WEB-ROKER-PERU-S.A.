meta {
  name: Cliente intenta ver los productos del almacenista
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/almacenista/productos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
