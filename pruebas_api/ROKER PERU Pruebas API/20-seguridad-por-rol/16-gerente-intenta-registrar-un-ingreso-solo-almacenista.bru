meta {
  name: Gerente intenta registrar un ingreso (solo almacenista)
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/almacenista/inventario/ingreso
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenGerente}}
}

body:json {
  {
    "productoId": {{idProd1}},
    "cantidad": 1,
    "tipoMovimiento": "INGRESO",
    "justificacion": "Prueba automatizada"
  }
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
