meta {
  name: Vendedor intenta descargar el reporte del gerente
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/gerente/reportes/productos/excel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
