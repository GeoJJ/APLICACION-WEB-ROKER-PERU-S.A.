meta {
  name: Administrador intenta crear un pedido (solo cliente)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/cliente/pedidos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "metodoPagoPedido": "efectivo",
    "detalles": [
      {
        "idProducto": {{idProd1}},
        "cantidadProducto": 1
      }
    ]
  }
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
