meta {
  name: Vendedor intenta ver mis pedidos de cliente
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/cliente/pedidos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
