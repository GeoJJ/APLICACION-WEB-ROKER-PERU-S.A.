meta {
  name: Sin token: confirmar un pedido
  type: http
  seq: 28
}

put {
  url: {{baseUrl}}/vendedor/pedidos/{{idPedido5}}/confirmar
  body: json
  auth: none
}

body:json {
  {
    "idDelivery": {{idRepartidor}}
  }
}

tests {
  test("Responde 401 o 403", function() {
    expect([401,403]).to.include(res.status);
  });
}
