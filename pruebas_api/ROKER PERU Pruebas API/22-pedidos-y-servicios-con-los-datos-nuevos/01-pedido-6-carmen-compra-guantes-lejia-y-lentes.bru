meta {
  name: Pedido 6: Carmen compra guantes, lejia y lentes
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/cliente/pedidos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenClienteB}}
}

body:json {
  {
    "metodoPagoPedido": "yape",
    "detalles": [
      { "idProducto": {{idProd4}}, "cantidadProducto": 2 },
      { "idProducto": {{idProd10}}, "cantidadProducto": 1 },
      { "idProducto": {{idProd7}}, "cantidadProducto": 1 }
    ]
  }
}

script:post-response {
  if (res.status === 201 || res.status === 200) { bru.setVar("idPedido6", res.body.idPedido); }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Estado PENDIENTE", function() {
    expect(res.body.estadoPedido).to.equal("PENDIENTE");
  });

  test("Monto total S/ 100.40", function() {
    expect(res.body.montoTotalPedido).to.be.closeTo(100.4, 0.01);
  });

  test("Metodo de pago normalizado", function() {
    expect(res.body.metodoPagoPedido).to.equal("YAPE");
  });

  test("Tres detalles", function() {
    expect(res.body.detalles.length).to.equal(3);
  });
}
