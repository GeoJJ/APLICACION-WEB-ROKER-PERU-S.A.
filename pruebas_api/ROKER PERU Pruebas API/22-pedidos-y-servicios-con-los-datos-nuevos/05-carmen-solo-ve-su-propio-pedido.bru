meta {
  name: Carmen solo ve su propio pedido
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/cliente/pedidos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenClienteB}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("La lista incluye idPedido6", function() {
    const ids = res.body.map(x => Number(x.idPedido)); expect(ids).to.include(Number(bru.getVar("idPedido6")));
  });

  test("La lista NO incluye idPedido7", function() {
    const ids = res.body.map(x => Number(x.idPedido)); expect(ids).to.not.include(Number(bru.getVar("idPedido7")));
  });

  test("La lista NO incluye idPedido1", function() {
    const ids = res.body.map(x => Number(x.idPedido)); expect(ids).to.not.include(Number(bru.getVar("idPedido1")));
  });
}
