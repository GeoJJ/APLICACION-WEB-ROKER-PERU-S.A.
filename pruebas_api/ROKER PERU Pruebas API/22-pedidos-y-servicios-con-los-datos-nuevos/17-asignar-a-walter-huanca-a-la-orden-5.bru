meta {
  name: Asignar a Walter Huanca a la orden 5
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/vendedor/asignaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor3}}
}

body:json {
  {
    "idOrdenServicio": {{idOrden5}},
    "idEmpleado": {{idEmp6}},
    "nombreResponsableAsignacion": "Andrea Sofia Ramirez Choque",
    "descripcionAsignacion": "Corte de cesped y poda de arbustos"
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Nombre completo del empleado", function() {
    expect(res.body.nombreCompletoEmpleado).to.equal("WALTER HUANCA CUTIPA");
  });
}
