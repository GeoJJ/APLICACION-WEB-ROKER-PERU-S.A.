meta {
  name: Asignar a Sandra Choque a la orden 6
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/vendedor/asignaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor2}}
}

body:json {
  {
    "idOrdenServicio": {{idOrden6}},
    "idEmpleado": {{idEmp7}},
    "nombreResponsableAsignacion": "Lucia Fernanda Paredes Salas",
    "descripcionAsignacion": "Nebulizacion de oficinas y salon principal"
  }
}

tests {
  test("Responde 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Nombre completo del empleado", function() {
    expect(res.body.nombreCompletoEmpleado).to.equal("SANDRA MILAGROS CHOQUE ANCO");
  });
}
