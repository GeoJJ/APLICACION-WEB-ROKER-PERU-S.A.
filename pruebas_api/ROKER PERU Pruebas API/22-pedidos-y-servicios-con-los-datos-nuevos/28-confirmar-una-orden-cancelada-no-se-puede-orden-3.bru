meta {
  name: Confirmar una orden CANCELADA no se puede (orden 3)
  type: http
  seq: 28
}

put {
  url: {{baseUrl}}/vendedor/ordenes-servicio/{{idOrden3}}/confirmar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor3}}
}

tests {
  test("Responde 409", function() {
    expect(res.status).to.equal(409);
  });

  test("Cuerpo de error con status 409", function() {
    expect(res.body.status).to.equal(409);
  });
}
