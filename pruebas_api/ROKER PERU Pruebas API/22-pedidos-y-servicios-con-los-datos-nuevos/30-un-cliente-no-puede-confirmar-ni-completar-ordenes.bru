meta {
  name: Un cliente no puede confirmar ni completar ordenes
  type: http
  seq: 30
}

put {
  url: {{baseUrl}}/vendedor/ordenes-servicio/{{idOrden5}}/confirmar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
