meta {
  name: El stock de cascos bajo a 38
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/vendedor/inventario/stock/{{idProd8}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("40 - 2 = 38", function() {
    expect(res.body).to.equal(38);
  });
}
