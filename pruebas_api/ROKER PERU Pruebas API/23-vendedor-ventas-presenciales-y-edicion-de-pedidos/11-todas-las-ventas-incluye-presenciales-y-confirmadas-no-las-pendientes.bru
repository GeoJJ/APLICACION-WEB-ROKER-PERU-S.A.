meta {
  name: Todas las ventas: incluye presenciales y confirmadas, no las pendientes
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/vendedor/pedidos/ventas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("La lista incluye idPedidoPresencial", function() {
    const ids = res.body.map(x => Number(x.idPedido)); expect(ids).to.include(Number(bru.getVar("idPedidoPresencial")));
  });

  test("La lista incluye idPedidoPresencial2", function() {
    const ids = res.body.map(x => Number(x.idPedido)); expect(ids).to.include(Number(bru.getVar("idPedidoPresencial2")));
  });

  test("La lista incluye idPedido1", function() {
    const ids = res.body.map(x => Number(x.idPedido)); expect(ids).to.include(Number(bru.getVar("idPedido1")));
  });

  test("La lista NO incluye idPedido5 (sigue pendiente)", function() {
    const ids = res.body.map(x => Number(x.idPedido)); expect(ids).to.not.include(Number(bru.getVar("idPedido5")));
  });
}
