meta {
  name: El administrador descarga el comprobante de la venta presencial
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/comprobantes/pedidos/{{idPedidoPresencial}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Es un PDF", function() {
    expect(res.getHeader("content-type")).to.contain("application/pdf");
  });

  test("Nombre de archivo correcto", function() {
    expect(res.getHeader("content-disposition")).to.contain("comprobante-" + bru.getVar("compPresencial"));
  });

  test("El PDF no esta vacio", function() {
    expect(res.getSize().body).to.be.greaterThan(1000);
  });
}
