}

get {
  url: {{baseUrl}}/repartidor/pedidos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenRepartidor}}
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("La lista NO incluye idPedido2", function() {
    const ids = res.body.map(x => Number(x.idPedido)); expect(ids).to.not.include(Number(bru.getVar("idPedido2")));
  });
}
