meta {
  name: Un pedido cancelado no se puede editar
  type: http
  seq: 25
}

put {
  url: {{baseUrl}}/vendedor/pedidos/{{idPedido4}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVendedor2}}
}

body:json {
  {
    "idDelivery": {{idRepartidor}}
  }
}

tests {
  test("Responde 409", function() {
    expect(res.status).to.equal(409);
  });

  test("Cuerpo de error con status 409", function() {
    expect(res.body.status).to.equal(409);
  });
}
