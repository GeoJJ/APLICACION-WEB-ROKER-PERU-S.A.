meta {
  name: Un cliente no puede registrar ventas presenciales
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/vendedor/pedidos/presencial
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "metodoPagoPedido": "efectivo",
    "detalles": [
      { "idProducto": {{idProd12}}, "cantidadProducto": 1 }
    ]
  }
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
