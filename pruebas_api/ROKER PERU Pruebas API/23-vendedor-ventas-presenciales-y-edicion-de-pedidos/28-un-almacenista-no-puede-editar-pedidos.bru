meta {
  name: Un almacenista no puede editar pedidos
  type: http
  seq: 28
}

put {
  url: {{baseUrl}}/vendedor/pedidos/{{idPedido2}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAlmacenista}}
}

body:json {
  {
    "idDelivery": {{idRepartidor}}
  }
}

tests {
  test("Responde 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Cuerpo de error con status 403", function() {
    expect(res.body.status).to.equal(403);
  });
}
