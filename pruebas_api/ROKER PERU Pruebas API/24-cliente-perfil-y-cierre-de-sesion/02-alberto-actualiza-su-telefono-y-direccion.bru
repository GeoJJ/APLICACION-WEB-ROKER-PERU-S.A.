meta {
  name: Alberto actualiza su telefono y direccion
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/cliente/perfil
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenClienteC}}
}

body:json {
  {
    "nombreUsuario": "Alberto Jose Villanueva Zegarra",
    "correoUsuario": "alberto.villanueva.{{run}}@rokerperu.test",
    "telefonoUsuario": "951234567",
    "numeroDocumentoUsuario": "{{dniClienteC}}",
    "direccionUsuario": "Calle Mercaderes 245, Cercado, Arequipa"
  }
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Telefono actualizado", function() {
    expect(res.body.telefonoUsuario).to.equal("951234567");
  });

  test("Direccion actualizada", function() {
    expect(res.body.direccionUsuario).to.equal("Calle Mercaderes 245, Cercado, Arequipa");
  });
}
