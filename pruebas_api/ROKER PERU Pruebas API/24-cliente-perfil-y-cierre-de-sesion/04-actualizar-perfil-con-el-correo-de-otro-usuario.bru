meta {
  name: Actualizar perfil con el correo de otro usuario
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/cliente/perfil
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenClienteC}}
}

body:json {
  {
    "nombreUsuario": "Alberto Jose Villanueva Zegarra",
    "correoUsuario": "carlos.mendoza.{{run}}@rokerperu.test",
    "telefonoUsuario": "951234567",
    "numeroDocumentoUsuario": "{{dniClienteC}}",
    "direccionUsuario": "Calle Mercaderes 245, Cercado, Arequipa"
  }
}

tests {
  test("Responde 409", function() {
    expect(res.status).to.equal(409);
  });

  test("Cuerpo de error con status 409", function() {
    expect(res.body.status).to.equal(409);
  });
}
