meta {
  name: Login con la contrasena nueva
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correoUsuario": "alberto.villanueva.{{run}}@rokerperu.test",
    "passwordUsuario": "NuevaClave456"
  }
}

script:post-response {
  if (res.status === 200) { bru.setVar("tokenClienteC", res.body.token); }
}

tests {
  test("Responde 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Devuelve un token JWT", function() {
    expect(res.body.token.split(".").length).to.equal(3);
  });
}
